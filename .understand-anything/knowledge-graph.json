{
  "project": "空调温控 uni-app",
  "description": "ESP8266 空调温控系统的移动端控制应用（uni-app + Vue 2/3）",
  "version": "2.0.0",
  "framework": "uni-app (HBuilderX)",
  "targets": [
    "Android App (app-plus)",
    "H5",
    "微信小程序"
  ],
  "architecture": {
    "pattern": "分层架构 + Mixin 复用",
    "communication": "HTTP POST 到 ESP8266 设备 :80 端口（非 TCP Socket）",
    "state_management": "uni.getStorageSync 本地存储 + uni.$emit/uni.$on 跨页事件",
    "polling": "10 秒间隔轮询设备状态",
    "ui_framework": "原生 rpx 响应式布局 + 自定义组件库"
  },
  "layers": [
    {
      "id": "entry",
      "name": "入口层",
      "description": "应用启动与全局配置",
      "nodes": [
        "main.js",
        "App.vue",
        "manifest.json",
        "pages.json"
      ]
    },
    {
      "id": "config",
      "name": "配置层",
      "description": "全局常量与映射表",
      "nodes": [
        "config/constants.js"
      ]
    },
    {
      "id": "services",
      "name": "服务层",
      "description": "设备通信与错误处理",
      "nodes": [
        "services/api.js",
        "services/errorHandler.js"
      ]
    },
    {
      "id": "mixins",
      "name": "复用层",
      "description": "跨页面逻辑复用",
      "nodes": [
        "mixins/device-mixin.js",
        "mixins/modal-mixin.js"
      ]
    },
    {
      "id": "components",
      "name": "组件层",
      "description": "可复用 UI 组件",
      "nodes": [
        "components/Button.vue",
        "components/Card.vue",
        "components/CustomModal.vue",
        "components/Loading.vue",
        "components/SettingItem.vue"
      ]
    },
    {
      "id": "pages",
      "name": "页面层",
      "description": "用户交互页面",
      "nodes": [
        "pages/index/index.vue",
        "pages/device/device.vue",
        "pages/settings/settings.vue",
        "pages/settings/temp-hum.vue",
        "pages/settings/ac-params.vue",
        "pages/settings/calibration.vue",
        "pages/settings/device-info.vue",
        "pages/settings/ota.vue",
        "pages/settings/wifi-settings.vue",
        "pages/settings/ap-wifi.vue",
        "pages/settings/sta-wifi.vue",
        "pages/settings/mqtt-config.vue",
        "pages/settings/scene.vue",
        "pages/settings/sleep-settings.vue",
        "pages/settings/about.vue"
      ]
    },
    {
      "id": "modules",
      "name": "原生模块层",
      "description": "uni-app 原生能力扩展",
      "nodes": [
        "uni_modules/uni-wifi"
      ]
    },
    {
      "id": "static",
      "name": "资源层",
      "description": "静态资源与图标",
      "nodes": [
        "static/icons/ (50+ SVG)",
        "static/logo.png"
      ]
    }
  ],
  "nodes": {
    "main.js": {
      "layer": "entry",
      "description": "应用入口，兼容 Vue 2/3 双模式启动",
      "key_features": [
        "Vue 2 入口（new Vue + $mount）",
        "Vue 3 入口（createSSRApp）",
        "条件编译 #ifdef/#endif"
      ],
      "dependencies": [
        "App.vue"
      ]
    },
    "App.vue": {
      "layer": "entry",
      "description": "全局应用组件，提供全局错误提示 Toast",
      "key_features": [
        "全局 error 状态管理",
        "slideUp 动画错误提示",
        "onLaunch/onShow/onHide 生命周期"
      ],
      "dependencies": []
    },
    "manifest.json": {
      "layer": "entry",
      "description": "uni-app 应用配置清单，定义平台能力与打包参数",
      "key_features": [
        "app-plus Android 权限配置（WiFi/Camera/Location）",
        "splashscreen 启动图",
        "多平台配置（mp-weixin/mp-alipay/mp-baidu/mp-toutiao）",
        "vueVersion: 3",
        "locale: zh-Hans"
      ],
      "dependencies": []
    },
    "pages.json": {
      "layer": "entry",
      "description": "页面路由配置，定义 16 个页面路径与导航栏样式",
      "key_features": [
        "16 个页面路由",
        "全局导航栏样式（#F8F8F8 背景）",
        "app-plus bounce: none（禁用下拉刷新）",
        "uniIdRouter 占位"
      ],
      "dependencies": []
    },
    "config/constants.js": {
      "layer": "config",
      "description": "全局常量配置中心，集中管理所有魔法数字与映射表",
      "key_features": [
        "HTTP_TIMEOUT: 8000ms",
        "POLL_INTERVAL: 10000ms",
        "DEFAULT_IP: 192.168.4.1",
        "OTA_TIMEOUT: 60000ms",
        "BRAND_MAP: 15 个空调品牌",
        "MODE_LABELS: 制冷/制热/除湿/送风/自动",
        "FAN_LABELS: 5 档风速",
        "SWING_LABELS: 摆风/定向",
        "ERROR_MESSAGES: 6 类错误提示",
        "SCENES: 4 个场景预设",
        "EEPROM_FLUSH_INTERVAL: 60000ms"
      ],
      "dependencies": []
    },
    "services/api.js": {
      "layer": "services",
      "description": "设备通信核心，封装 HTTP POST 请求到 ESP8266 :80 端口",
      "key_features": [
        "ApiService 单例类",
        "连续失败计数判定离线（_maxFailCount=3）",
        "28 个 API 方法（）",
        "自动更新 connectedDevice 存储状态"
      ],
      "dependencies": [
        "config/constants.js"
      ],
      "consumed_by": [
        "pages/index/index.vue",
        "pages/device/device.vue",
        "pages/settings/settings.vue",
        "pages/settings/temp-hum.vue",
        "pages/settings/ac-params.vue",
        "pages/settings/calibration.vue",
        "pages/settings/device-info.vue",
        "pages/settings/ota.vue",
        "pages/settings/wifi-settings.vue",
        "pages/settings/ap-wifi.vue",
        "pages/settings/sta-wifi.vue",
        "pages/settings/mqtt-config.vue",
        "pages/settings/scene.vue",
        "pages/settings/sleep-settings.vue"
      ]
    },
    "services/errorHandler.js": {
      "layer": "services",
      "description": "错误处理工具类，提供统一的 Toast 提示",
      "key_features": [
        "handleError 错误分类（Network/Timeout/404/设备未连接）",
        "handleSuccess 成功提示",
        "showLoading/hideLoading 加载状态"
      ],
      "dependencies": []
    },
    "mixins/device-mixin.js": {
      "layer": "mixins",
      "description": "设备状态 mixin，抽取 checkDevice() 方法供页面复用",
      "key_features": [
        "checkDevice() 从 localStorage 读取 connectedDevice",
        "暴露 deviceConnected/deviceAddress/deviceId 数据"
      ],
      "dependencies": []
    },
    "mixins/modal-mixin.js": {
      "layer": "mixins",
      "description": "弹窗 mixin，抽取 showToast/showConfirm 方法供页面复用",
      "key_features": [
        "showToast 1.5 秒自动消失",
        "showConfirm 显示确定按钮",
        "handleModalConfirm/handleModalCancel 回调",
        "_modalCallback 回调机制"
      ],
      "dependencies": []
    },
    "components/Button.vue": {
      "layer": "components",
      "description": "基础按钮组件，支持 primary/secondary/danger 三种类型",
      "key_features": [
        "props: text/type/disabled",
        "type validator 限制三种类型",
        "hover 动画效果（translateY + box-shadow）"
      ],
      "dependencies": []
    },
    "components/Card.vue": {
      "layer": "components",
      "description": "卡片容器组件，支持标题、图标、自定义类名",
      "key_features": [
        "props: title/icon/customClass/isSvgIcon",
        "card-header + card-body 结构",
        "SVG 图标支持"
      ],
      "dependencies": []
    },
    "components/CustomModal.vue": {
      "layer": "components",
      "description": "自定义弹窗组件，支持 success/error/warning/info 四种类型",
      "key_features": [
        "props: visible/title/content/confirmText/cancelText/editable/passwordInput/showPassword",
        "type validator 限制四种类型",
        "密码输入框（8-16 位，眼睛切换）",
        "popIn 动画（cubic-bezier 弹性）",
        "toast 模式（无按钮自动消失）",
        "closeOnClickOverlay 可配置"
      ],
      "dependencies": []
    },
    "components/Loading.vue": {
      "layer": "components",
      "description": "全局加载遮罩组件，显示旋转 spinner + 文本",
      "key_features": [
        "props: visible/text",
        "spin 动画（1s linear infinite）",
        "scaleIn 动画",
        "z-index: 9999"
      ],
      "dependencies": []
    },
    "components/SettingItem.vue": {
      "layer": "components",
      "description": "设置项组件，支持图标、值显示、危险操作样式",
      "key_features": [
        "props: label/icon/value/disabled/isSvgIcon/danger",
        "danger 样式（红色图标背景 #FFF1F0）",
        "SVG 图标支持",
        "点击事件 emit"
      ],
      "dependencies": []
    },
    "pages/index/index.vue": {
      "layer": "pages",
      "description": "首页/控制面板，显示温湿度、空调状态、场景切换",
      "key_features": [
        "温度/湿度 Hero 卡片（根据 controlType 切换 C 位）",
        "空调开关 switch 控件（vibrateShort 震动反馈）",
        "场景快捷条（sleep/comfort/energy_saving/quick）",
        "10 秒轮询设备状态",
        "设备断开自动跳转 device 页",
        "uni.$on('deviceConnected') 事件监听",
        "品牌标签映射（15 个品牌）",
        "computed: tempColor/modeLabel/fanLabel/swingLabel/brandLabel/ruleBrief"
      ],
      "dependencies": [
        "services/api.js",
        "components/Loading.vue",
        "components/CustomModal.vue"
      ],
      "navigation": [
        "pages/settings/temp-hum",
        "pages/settings/ac-params",
        "pages/settings/settings"
      ]
    },
    "pages/device/device.vue": {
      "layer": "pages",
      "description": "设备连接页，支持 WiFi 扫描与手动 IP 输入",
      "key_features": [
        "WiFi 扫描（uni.getWifiList + 去重 + 信号强度排序）",
        "ESP 热点自动标记（SSID 含 esp/8266）",
        "信号强度可视化（4 档 bars）",
        "Android 位置权限请求（plus.android.requestPermissions）",
        "手动 IP 输入（正则验证）",
        "连接成功后异步查询 STA 状态",
        "staNetwork 存储（SSID→IP 映射，下次自动填充）",
        "openSystemWifi 跳转系统 WiFi 设置"
      ],
      "dependencies": [
        "services/api.js",
        "components/Loading.vue",
        "components/CustomModal.vue"
      ],
      "navigation": [
        "pages/index/index"
      ]
    },
    "pages/settings/settings.vue": {
      "layer": "pages",
      "description": "设置中心页，分类展示所有设置入口",
      "key_features": [
        "四大分类：控制策略/设备与网络/维护/其他",
        "危险操作确认弹窗（重启/深度睡眠/恢复出厂）",
        "清除缓存（uni.clearStorageSync）",
        "版本显示 v2.0.0"
      ],
      "dependencies": [
        "services/api.js",
        "components/SettingItem.vue",
        "components/CustomModal.vue"
      ],
      "navigation": [
        "scene",
        "sleep-settings",
        "calibration",
        "device-info",
        "wifi-settings",
        "mqtt-config",
        "ota",
        "about"
      ]
    },
    "pages/settings/temp-hum.vue": {
      "layer": "pages",
      "description": "温湿度阈值设置页",
      "key_features": [
        "控制类型切换（温度/湿度）",
        "阈值输入（temp_on/temp_off/hum_on/hum_off）",
        "检查间隔设置",
        "保存调用 apiService.setTempHum()"
      ],
      "dependencies": [
        "services/api.js",
        "mixins/device-mixin.js",
        "mixins/modal-mixin.js"
      ]
    },
    "pages/settings/ac-params.vue": {
      "layer": "pages",
      "description": "空调参数设置页",
      "key_features": [
        "温度调节（16-30°C）",
        "模式选择（制冷/制热/除湿/送风/自动）",
        "风速选择（5 档）",
        "摆风选择（摆风/定向）",
        "品牌选择（15 个品牌）"
      ],
      "dependencies": [
        "services/api.js",
        "mixins/device-mixin.js",
        "mixins/modal-mixin.js"
      ]
    },
    "pages/settings/calibration.vue": {
      "layer": "pages",
      "description": "温湿度校准页",
      "key_features": [
        "温度校准偏移（-10~+10°C）",
        "湿度校准偏移（-20~+20%）",
        "保存调用 apiService.setCalibration()"
      ],
      "dependencies": [
        "services/api.js",
        "mixins/device-mixin.js",
        "mixins/modal-mixin.js"
      ]
    },
    "pages/settings/device-info.vue": {
      "layer": "pages",
      "description": "设备信息页",
      "key_features": [
        "设备 ID 显示",
        "设备位置名称设置",
        "固件版本显示",
        "运行时间显示"
      ],
      "dependencies": [
        "services/api.js",
        "mixins/device-mixin.js",
        "mixins/modal-mixin.js"
      ]
    },
    "pages/settings/ota.vue": {
      "layer": "pages",
      "description": "OTA 固件升级页",
      "key_features": [
        "固件版本对比",
        "升级进度显示",
        "超时 60 秒",
        "升级后自动重启"
      ],
      "dependencies": [
        "services/api.js",
        "mixins/device-mixin.js",
        "mixins/modal-mixin.js"
      ]
    },
    "pages/settings/wifi-settings.vue": {
      "layer": "pages",
      "description": "网络设置总览页",
      "key_features": [
        "AP 热点设置入口",
        "STA 客户端 WiFi 入口",
        "WiFi 状态显示"
      ],
      "dependencies": [
        "services/api.js",
        "mixins/device-mixin.js",
        "mixins/modal-mixin.js"
      ],
      "navigation": [
        "ap-wifi",
        "sta-wifi"
      ]
    },
    "pages/settings/ap-wifi.vue": {
      "layer": "pages",
      "description": "AP 热点设置页",
      "key_features": [
        "SSID 设置（setSsid API）",
        "密码设置（setWifiPassword API）",
        "密码强度提示"
      ],
      "dependencies": [
        "services/api.js",
        "mixins/device-mixin.js",
        "mixins/modal-mixin.js"
      ]
    },
    "pages/settings/sta-wifi.vue": {
      "layer": "pages",
      "description": "STA 客户端 WiFi 设置页",
      "key_features": [
        "WiFi 扫描列表",
        "SSID/密码输入",
        "连接测试",
        "setStaWifi API"
      ],
      "dependencies": [
        "services/api.js",
        "mixins/device-mixin.js",
        "mixins/modal-mixin.js"
      ]
    },
    "pages/settings/mqtt-config.vue": {
      "layer": "pages",
      "description": "MQTT 配置页",
      "key_features": [
        "服务器地址/端口",
        "用户名/密码（可选）",
        "主题前缀",
        "setMqttConfig/getMqttConfig API"
      ],
      "dependencies": [
        "services/api.js",
        "mixins/device-mixin.js",
        "mixins/modal-mixin.js"
      ]
    },
    "pages/settings/scene.vue": {
      "layer": "pages",
      "description": "场景模式设置页",
      "key_features": [
        "4 个场景预设（sleep/comfort/energy_saving/quick）",
        "场景参数编辑",
        "setScene/getScene API"
      ],
      "dependencies": [
        "services/api.js",
        "mixins/device-mixin.js",
        "mixins/modal-mixin.js"
      ]
    },
    "pages/settings/sleep-settings.vue": {
      "layer": "pages",
      "description": "休眠开关设置页",
      "key_features": [
        "休眠开关 toggle",
        "setSleepEnabled/getSleepEnabled API",
        "深度睡眠说明"
      ],
      "dependencies": [
        "services/api.js",
        "mixins/device-mixin.js",
        "mixins/modal-mixin.js"
      ]
    },
    "pages/settings/about.vue": {
      "layer": "pages",
      "description": "关于页",
      "key_features": [
        "应用版本 v2.0.0",
        "开源协议",
        "作者信息"
      ],
      "dependencies": []
    },
    "uni_modules/uni-wifi": {
      "layer": "modules",
      "description": "uni-app WiFi 原生模块（UTS 跨平台实现）",
      "key_features": [
        "app-android/index.uts（Android 原生实现）",
        "app-ios/index.uts（iOS 原生实现）",
        "interface.uts（统一接口定义）",
        "unierror.uts（错误处理）"
      ],
      "dependencies": []
    },
    "static/icons/": {
      "layer": "static",
      "description": "50+ SVG 图标资源，覆盖所有 UI 场景",
      "key_features": [
        "air-conditioner/book/box/calibration/chart/check-circle/close/cloud/computer/device/error/error-outline/eye/eye-slash/fan/humidity/info/light/lightning/link/location/moon/refresh/reload/scene/search/settings/signal/sleep/smile/sun/sync/tag/target/temperature/thermometer/timer/trash/visibility/visibility-off/warning/water/wifi/wind"
      ],
      "dependencies": []
    },
    "static/logo.png": {
      "layer": "static",
      "description": "应用启动图/logo",
      "key_features": [
        "splashscreen 使用"
      ],
      "dependencies": []
    }
  },
