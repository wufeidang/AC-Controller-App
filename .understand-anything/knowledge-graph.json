  "tour": [
    {
      "step": 1,
      "node": "main.js",
      "title": "应用启动",
      "description": "main.js 根据编译条件选择 Vue 2 或 Vue 3 入口，挂载 App.vue"
    },
    {
      "step": 2,
      "node": "App.vue",
      "title": "全局容器",
      "description": "App.vue 提供全局错误提示 Toast，监听 onLaunch/onShow/onHide 生命周期"
    },
    {
      "step": 3,
      "node": "pages.json",
      "title": "路由配置",
      "description": "pages.json 定义 16 个页面路由，首页为 pages/index/index"
    },
    {
      "step": 4,
      "node": "pages/index/index.vue",
      "title": "首页/控制面板",
      "description": "首页显示温湿度 Hero 卡片、空调开关、场景快捷条，10 秒轮询设备状态"
    },
    {
      "step": 5,
      "node": "services/api.js",
      "title": "设备通信核心",
      "description": "ApiService 单例通过 HTTP POST 与 ESP8266 :80 通信，28 个 API 方法覆盖所有设备操作"
    },
    {
      "step": 6,
      "node": "config/constants.js",
      "title": "常量配置中心",
      "description": "集中管理超时时间、轮询间隔、品牌映射、模式标签、场景预设等所有魔法数字"
    },
    {
      "step": 7,
      "node": "pages/device/device.vue",
      "title": "设备连接页",
      "description": "支持 WiFi 扫描（uni.getWifiList）和手动 IP 输入，连接成功后异步查询 STA 状态"
    },
    {
      "step": 8,
      "node": "pages/settings/settings.vue",
      "title": "设置中心",
      "description": "四大分类展示所有设置入口：控制策略/设备与网络/维护/其他，危险操作需二次确认"
    },
    {
      "step": 9,
      "node": "components/CustomModal.vue",
      "title": "自定义弹窗",
      "description": "支持 success/error/warning/info 四种类型，密码输入框，popIn 弹性动画"
    },
    {
      "step": 10,
      "node": "mixins/device-mixin.js",
      "title": "设备状态复用",
      "description": "checkDevice() 方法从 localStorage 读取设备连接状态，供 14 个设置页复用"
    },
    {
      "step": 11,
      "node": "mixins/modal-mixin.js",
      "title": "弹窗逻辑复用",
      "description": "showToast/showConfirm 方法供页面复用，_modalCallback 回调机制"
    },
    {
      "step": 12,
      "node": "uni_modules/uni-wifi",
      "title": "原生 WiFi 模块",
      "description": "UTS 跨平台实现，Android/iOS 原生 WiFi 操作能力"
    },
    {
      "step": 13,
      "node": "static/icons/",
      "title": "图标资源库",
      "description": "50+ SVG 图标覆盖所有 UI 场景，通过 /static/icons/{name}.svg 路径引用"
    }
  ],
